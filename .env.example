# Hostinger MySQL (use 127.0.0.1 for apps hosted on Hostinger)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_database_password

# Generate a unique random value for production. Keep it secret.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional first-deploy admin bootstrap. Remove both after first successful start.
# INITIAL_ADMIN_EMAIL=admin@your-domain.com
# INITIAL_ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters

# Titan Email SMTP (server-side only)
MAIL_ENABLED=true
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=your-mailbox@your-domain.com
SMTP_PASSWORD=your-mailbox-password
MAIL_FROM_NAME="Baba Hakeem"
MAIL_FROM_ADDRESS=your-mailbox@your-domain.com
MAIL_NOTIFY_TO=your-mailbox@your-domain.com
SITE_URL=https://your-domain.com
